{
  "name": "@vetwo/repo-fetch",
  "version": "1.0.0",
  "description": "Download selected files and folders from Git repositories without cloning the entire repository",
  "keywords": [
    "azure-devops",
    "bitbucket",
    "download",
    "forgejo",
    "git",
    "gitea",
    "github",
    "gitlab",
    "partial-clone",
    "sparse-checkout"
  ],
  "homepage": "https://github.com/VeTwo-dev/Repo-Fetch/repo-fetch#readme",
  "bugs": {
    "url": "https://github.com/VeTwo-dev/Repo-Fetch/issues"
  },
  "license": "MIT",
  "author": "Vetwo (https://vetwo.dev)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/VeTwo-dev/Repo-Fetch.git"
  },
  "bin": {
    "repo-fetch": "./dist/cli/index.js"
  },
  "files": [
    "dist/",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.js"
    },
    "./cli": {
      "types": "./dist/cli/index.d.ts",
      "import": "./dist/cli/index.js",
      "require": "./dist/cli/index.js"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup",
    "build:fast": "tsup --no-dts",
    "dev": "tsup --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "pnpm run lint:oxlint && pnpm run lint:eslint",
    "lint:fix": "oxlint -c .oxlintrc.json --fix . && eslint --config eslint.typeaware.config.js src/ tests/ --fix",
    "format": "oxfmt --write 'src/**/*.ts' 'tests/**/*.ts'",
    "format:check": "oxfmt --check 'src/**/*.ts' 'tests/**/*.ts'",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run build && npm run format &&  npm run test && npm run lint",
    "link:local": "npm link",
    "unlink:local": "npm unlink -g @vetwo/repo-fetch",
    "relink": "npm unlink -g @vetwo/repo-fetch && npm link",
    "release": "npm run build && npm run test && npm run lint && npm publish",
    "lint:oxlint": "oxlint -c .oxlintrc.json .",
    "lint:eslint": "eslint --config eslint.typeaware.config.js src/ tests/",
    "lint:eslint:legacy": "eslint ."
  },
  "dependencies": {
    "@clack/prompts": "^1.7.0",
    "commander": "^15.0.0",
    "fs-extra": "^11.4.0",
    "lru-cache": "^11.5.2",
    "ohash": "2.0.11",
    "ora": "^9.4.1",
    "p-limit": "^7.3.1",
    "p-retry": "^8.0.0",
    "pathe": "^2.0.3",
    "picocolors": "^1.1.1",
    "undici": "^8.8.0",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@types/fs-extra": "^11.0.4",
    "@types/node": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "eslint": "catalog:",
    "prettier": "catalog:",
    "tsup": "catalog:",
    "typescript": "catalog:",
    "typescript-eslint": "catalog:",
    "vitest": "catalog:"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": []
  }
}
